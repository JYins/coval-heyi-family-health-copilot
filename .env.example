# Copy to .env locally. Do not commit .env.

# Model/runtime
BASE_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_HOME=
TRANSFORMERS_CACHE=
COVAL_MODEL_PROVIDER=mock
# Use transformers_base only for an adapter-off causal benchmark.
# Required for transformers_base or transformers_adapter. Adapter mode also requires the adapter path. Runtime loading is local-only.
COVAL_MODEL_BASE_PATH=
COVAL_MODEL_ADAPTER_PATH=
COVAL_TRANSFORMERS_DEVICE_MAP=auto
COVAL_TRANSFORMERS_LOAD_IN_4BIT=false
# Required when COVAL_MODEL_PROVIDER=llama_cpp.
COVAL_MODEL_GGUF_PATH=
COVAL_LLAMA_N_CTX=4096
COVAL_LLAMA_N_GPU_LAYERS=0
COVAL_MODEL_MAX_NEW_TOKENS=1536
# Prompt is instance-scoped. Keep schema_v3 as the product default; candidates
# require a frozen eval before promotion.
COVAL_MODEL_PROMPT_VERSION=schema_v3
# Optional process-level backend egress guard; loopback remains allowed.
COVAL_BLOCK_NON_LOOPBACK=false

# Synthetic/public-safe demo data only. Do not point this build at real family data.
COVAL_DATA_DIR=
# Exact database path takes precedence over COVAL_DATA_DIR.
COVAL_HEALTH_DB_PATH=
# Comma-separated additional local web origins, if needed.
COVAL_ALLOWED_ORIGINS=
# Deliberately keep false. Setting true fails closed until docs/THREAT_MODEL.md gates pass.
COVAL_REAL_DATA_MODE=false

# Optional API keys, if ever used. Prefer local/offline runs for private data.
HUGGINGFACE_TOKEN=
OPENAI_API_KEY=

# Narval non-secret defaults
NARVAL_HOST=narval.computecanada.ca
NARVAL_USER=syin94
NARVAL_ACCOUNT=def-falmaham
NARVAL_PROJECT_ROOT=/home/syin94/scratch/lora_health
